# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte key (base64) used to encrypt Alpaca API keys at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Shared secret the cron pinger (cron-job.org) must send as
# "Authorization: Bearer <CRON_SECRET>" to trigger /api/cron/check-thresholds
CRON_SECRET=
